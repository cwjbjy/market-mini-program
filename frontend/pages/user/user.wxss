.account {
  padding-bottom: calc(36rpx + var(--tab-bar-height));
  padding-bottom: calc(36rpx + var(--tab-bar-height) + env(safe-area-inset-bottom));
}
.account-header {
  display: flex;
  align-items: center;
  min-height: 194rpx;
  padding: 26rpx 30rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--panel-radius);
  background: var(--soft);
  color: var(--ink);
}
.account-avatar { flex: none; width: 108rpx; height: 108rpx; margin-right: 22rpx; border: 4rpx solid var(--surface); border-radius: 50%; background: var(--soft); }
.account-title { min-width: 0; font-size: 39rpx; line-height: 1.2; font-weight: 700; overflow-wrap: anywhere; }
.account-links { margin-top: 20rpx; padding: 4rpx 24rpx; }
button.account-link { display: flex; align-items: center; width: 100%; max-width: none; min-height: 110rpx; padding: 0; color: var(--muted); }
.account-link + .account-link { border-top: 1rpx solid var(--line); }
.account-link__icon { display: flex; align-items: center; justify-content: center; flex: none; width: 64rpx; height: 64rpx; margin-right: 16rpx; border-radius: var(--field-radius); background: var(--brand-light); color: var(--brand); }
.account-link__title { flex: 1; min-width: 0; text-align: left; color: var(--ink); font-size: 28rpx; font-weight: 600; }
