<view class="account">
  <view class="account-header">
    <image class="account-avatar" src="/static/user/avatar.png" mode="aspectFill" />
    <text class="account-title">爱情厨房</text>
  </view>
  <view class="account-links panel">
    <button class="account-link" bindtap="goToOrders">
      <view class="account-link__icon"><t-icon name="file" size="38rpx" /></view>
      <text class="account-link__title">订单记录</text>
      <t-icon name="chevron-right" size="34rpx" />
    </button>
    <button class="account-link" bindtap="goToCategories">
      <view class="account-link__icon"><t-icon name="view-list" size="38rpx" /></view>
      <text class="account-link__title">分类管理</text>
      <t-icon name="chevron-right" size="34rpx" />
    </button>
  </view>
</view>
