.orders-page { padding: 22rpx 24rpx 28rpx; }
.orders-list { display: flex; flex-direction: column; gap: 20rpx; }
.order-card { padding: 0 24rpx; }
.order-card__head, .order-card__foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 94rpx; }
.order-card__head { border-bottom: 1rpx solid var(--line); }
.order-card__mark { display: flex; justify-content: center; align-items: center; width: 58rpx; height: 58rpx; background: var(--brand-light); color: var(--brand); border-radius: 17rpx; }
.order-card__date { flex: 1; font-size: 28rpx; font-weight: 700; }
.order-card__status { padding: 7rpx 14rpx; border-radius: 14rpx; background: #EEF1E7; color: #475B37; font-size: 22rpx; }
.order-card__body { display: flex; flex-direction: column; gap: 15rpx; padding: 18rpx 0; }
.order-item { display: flex; align-items: center; gap: 16rpx; min-height: 76rpx; }
.order-item__image { flex: none; width: 76rpx; height: 76rpx; border-radius: 14rpx; }
.order-item__name { flex: 1; min-width: 0; font-weight: 600; }
.order-item__ingredients { display: block; overflow: hidden; margin-top: 4rpx; white-space: nowrap; text-overflow: ellipsis; color: var(--muted); font-size: 24rpx; font-weight: 400; }
.order-item__quantity { color: var(--brand); font-weight: 700; }
.order-card__foot { min-height: 80rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 25rpx; }
.delete-button { min-height: 68rpx; padding: 0 8rpx 0 20rpx; color: var(--brand); }
.orders-end { margin: 8rpx 0; text-align: center; color: var(--muted); font-size: 24rpx; }
.orders-empty { padding-top: 160rpx; }
.orders-empty__image { width: 105rpx; height: 105rpx; }
.orders-warning { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; padding: 0 10rpx 0 22rpx; color: var(--brand); }
