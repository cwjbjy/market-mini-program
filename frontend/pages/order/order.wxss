.orders-page {
  padding-bottom: calc(32rpx + var(--tab-bar-height));
  padding-bottom: calc(32rpx + var(--tab-bar-height) + env(safe-area-inset-bottom));
}
.orders-list { display: flex; flex-direction: column; }
.order-card { margin-bottom: 20rpx; overflow: hidden; }
.order-card__head { display: flex; align-items: center; min-height: 85rpx; padding: 16rpx var(--gutter); border-bottom: 1rpx solid var(--line); background: var(--field); }
.order-card__dot { flex: none; width: 10rpx; height: 10rpx; margin-right: 12rpx; border-radius: 50%; background: var(--brand); }
.order-card__date { flex: 1; min-width: 0; color: var(--ink); font-size: 28rpx; font-weight: 600; overflow-wrap: anywhere; }
.order-card__total { flex: none; margin-left: 10rpx; padding: 4rpx 13rpx; border-radius: 20rpx; background: var(--brand-light); color: var(--brand); font-size: 24rpx; font-weight: 600; }
.order-card__body { padding: 0 var(--gutter); }
.order-item { display: flex; align-items: center; padding: 16rpx 0; }
.order-item + .order-item { border-top: 1rpx solid var(--line); }
.order-item__image { flex: none; width: 104rpx; height: 104rpx; margin-right: 17rpx; border-radius: var(--field-radius); }
.order-item__name { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 29rpx; font-weight: 650; }
.order-item__ingredients { display: block; overflow: hidden; margin-top: 5rpx; color: var(--muted); font-size: 23rpx; font-weight: 400; white-space: nowrap; text-overflow: ellipsis; }
.order-item__quantity { flex: none; margin-left: 12rpx; color: var(--brand); font-weight: 700; }
.order-card__foot { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; padding: 10rpx 27rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 25rpx; }
button.delete-button { display: flex; min-height: 57rpx; padding: 0 16rpx; border: 1rpx solid var(--line); border-radius: 24rpx; font-size: 24rpx; }
.orders-end { display: block; margin: 12rpx 0; text-align: center; color: var(--muted); font-size: 23rpx; }
.orders-empty { min-height: 66vh; justify-content: center; }
.orders-empty .state__symbol { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--soft); }
.orders-empty .primary { min-width: 176rpx; margin-top: 12rpx; }
.orders-warning { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; padding: 0 6rpx 0 18rpx; background: var(--accent-light); color: var(--accent); }
