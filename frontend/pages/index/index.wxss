.home {
  display: flex;
  flex-direction: column;
  height: calc(100vh - var(--tab-bar-height));
  height: calc(100vh - var(--tab-bar-height) - env(safe-area-inset-bottom));
  min-width: 0;
  overflow: hidden;
}

.menu-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: none;
  padding: 72px 34rpx 14rpx;
  background: linear-gradient(110deg, var(--hero-light), var(--hero-shade));
}
.menu-hero__image {
  flex: none;
  width: 156rpx;
  height: 136rpx;
  margin-left: 16rpx;
  mix-blend-mode: multiply;
}
.menu-hero__copy { min-width: 0; color: var(--ink); }
.menu-hero__title { display: block; font-size: 46rpx; line-height: 1.2; font-weight: 700; }
.menu-hero__meta { display: block; margin-top: 9rpx; color: var(--muted); font-size: 24rpx; }

.toolbar {
  display: flex;
  align-items: center;
  flex: none;
  padding: 16rpx var(--gutter);
  border-bottom: 1rpx solid var(--line);
  background: var(--surface);
}
.search-box {
  display: flex;
  align-items: center;
  flex: 1 1 0;
  min-width: 0;
  height: 76rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--field-radius);
  background: var(--field);
  color: var(--muted);
}
.search-input { flex: 1 1 0; width: 0; min-width: 0; height: 66rpx; margin-left: 9rpx; color: var(--ink); font-size: 26rpx; }
button.toolbar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 152rpx;
  width: 152rpx;
  height: 72rpx;
  margin-left: 12rpx;
  padding: 0;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.25;
}
.toolbar-action text { margin-left: 5rpx; white-space: nowrap; }
.toolbar-action--add { background: var(--brand); color: var(--on-brand); }
.toolbar-action--categories { border: 1rpx solid var(--line); background: var(--surface); color: var(--muted); }
button.toolbar-dice {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-left: 12rpx;
  padding: 0;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
  color: var(--muted);
}
.toolbar-dice__glyph { font-size: 34rpx; line-height: 1; }
button.toolbar-dice[disabled] { opacity: .55; }
button.icon-button { display: flex; align-items: center; justify-content: center; flex: none; padding: 0; color: var(--muted); }
button.search-clear { width: 43rpx; height: 62rpx; margin-right: -5rpx; }

.catalog { position: relative; flex: 1 1 0; min-height: 0; overflow: hidden; }
.category-sidebar {
  position: absolute;
  top: 0;
  left: 0;
  width: 152rpx;
  height: 100%;
  padding: 10rpx 0 22rpx;
  border-right: 1rpx solid var(--line);
  background: var(--surface);
}
button.category-button {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(100% - 24rpx);
  height: 132rpx;
  margin: 5rpx 12rpx 8rpx;
  padding: 0 6rpx;
  border-radius: 18rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.3;
}
button.category-button--active { background: var(--brand-light); color: var(--brand); font-weight: 700; }
.category-button--active::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 4rpx;
  height: 36rpx;
  transform: translateY(-50%);
  border-radius: 0 5rpx 5rpx 0;
  background: var(--brand);
  content: '';
}
.category-button__image { flex: none; width: 64rpx; height: 64rpx; margin-bottom: 8rpx; border: 1rpx solid var(--line); border-radius: 50%; }
.category-button__label { display: block; max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.catalog-scroll { position: absolute; top: 0; left: 152rpx; width: calc(100% - 152rpx); height: 100%; }
.catalog-scroll--empty { left: 0; width: 100%; }
.catalog-section { padding: 0 20rpx 18rpx; }
.catalog-section:last-child { min-height: 100%; }
.section-title { display: flex; align-items: center; padding: 22rpx 4rpx 15rpx; }
.section-title__dot { flex: none; width: 10rpx; height: 10rpx; margin-right: 11rpx; border-radius: 50%; background: var(--brand); }
.section-title__name { flex: 1; min-width: 0; margin-right: 8rpx; overflow: hidden; font-size: 28rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.section-title__count { flex: none; padding: 4rpx 14rpx; border-radius: 20rpx; background: var(--soft); color: var(--muted); font-size: 22rpx; }
.section-empty { padding: 24rpx; border-radius: 18rpx; background: var(--soft); color: var(--muted); font-size: 24rpx; }

.home-recipe-sort-row { position: relative; padding-bottom: 12rpx; }
.swipe-wrapper { display: block; overflow: hidden; border-radius: var(--panel-radius); }
.home-sort-row--dragging { z-index: 2; }
button.category-button.home-sort-row--dragging { background: var(--brand-light); box-shadow: 0 3rpx 12rpx var(--shadow); }
.home-sort-row--dragging .swipe-wrapper { box-shadow: 0 3rpx 12rpx var(--shadow); }
.home-drop-line { position: absolute; z-index: 3; top: 0; right: 8rpx; left: 8rpx; height: 3rpx; border-radius: 3rpx; background: var(--brand); pointer-events: none; }
.home-drop-line--after { top: auto; bottom: 0; }
.home-recipe-sort-row > .home-drop-line--after { bottom: 4rpx; }
button.recipe-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  max-width: 144rpx;
  height: 100%;
  padding: 0;
  background: var(--danger);
  color: var(--surface);
  font-size: 28rpx;
  font-weight: 600;
}
.recipe-card { display: flex; align-items: center; min-height: 169rpx; padding: 10rpx; border: 1rpx solid var(--line); border-radius: var(--panel-radius); background: var(--surface); }
.recipe-card__image { flex: 0 0 144rpx; width: 144rpx; height: 144rpx; border-radius: var(--field-radius); }
.recipe-card__body { display: flex; flex: 1; flex-direction: column; justify-content: space-between; align-self: stretch; min-width: 0; padding: 7rpx 2rpx 0 15rpx; }
.recipe-card__description { min-width: 0; }
.recipe-card__title { display: -webkit-box; overflow: hidden; overflow-wrap: anywhere; font-size: 28rpx; line-height: 1.28; font-weight: 700; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.recipe-card__ingredients { display: block; overflow: hidden; margin-top: 4rpx; color: var(--muted); font-size: 23rpx; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.recipe-card__controls { display: flex; align-items: center; justify-content: flex-end; }
.recipe-card__count { flex: 1; min-width: 0; overflow: hidden; color: var(--muted); font-size: 20rpx; white-space: nowrap; text-overflow: ellipsis; }

.quantity { display: inline-flex; align-items: center; flex: none; height: 44px; }
.quantity > button.quantity__button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  width: 44px;
  min-width: 44px;
  max-width: 44px;
  height: 44px;
  padding: 0;
  background: transparent;
  line-height: 1;
}
.quantity__glyph { display: flex; align-items: center; justify-content: center; width: 27px; height: 27px; border: 1rpx solid var(--brand); border-radius: 50%; color: var(--brand); }
.quantity__button--plus .quantity__glyph { background: var(--brand); color: var(--on-brand); }
.quantity > button.quantity__button[disabled] { background: transparent; opacity: .55; }
.quantity__value { min-width: 26rpx; padding: 0 2rpx; text-align: center; font-size: 24rpx; font-weight: 600; }

.catalog-state { margin: 20rpx 26rpx; padding-top: 50rpx; padding-bottom: 50rpx; }
.inline-warning { display: flex; justify-content: space-between; align-items: center; flex: none; padding-left: 24rpx; background: var(--accent-light); color: var(--accent); font-size: 24rpx; }
.inline-warning .quiet { flex: none; min-height: 56rpx; }

.order-bar {
  flex: none;
  margin: 8rpx 24rpx 12rpx;
  overflow: hidden;
  border-radius: 36rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow);
}
button.basket-link {
  display: flex;
  align-items: stretch;
  width: 100%;
  min-width: 100%;
  min-height: 104rpx;
  min-height: max(104rpx, 44px);
  padding: 0;
  background: var(--dark);
  color: var(--on-dark);
  text-align: left;
}
.basket-summary { display: flex; flex: 1 1 0; align-items: center; min-width: 0; padding: 12rpx 22rpx; }
.basket-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 62rpx; height: 62rpx; margin-right: 14rpx; border-radius: 50%; background: var(--brand); }
.basket-link__copy { min-width: 0; }
.basket-label, .basket-note { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.basket-label { font-size: 28rpx; font-weight: 700; }
.basket-note { color: var(--on-dark-muted); font-size: 22rpx; }
.checkout-label {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 176rpx;
  background: var(--accent-fill);
  color: var(--on-accent);
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.basket-header { display: flex; align-items: center; min-height: 81rpx; }
.basket-heading { flex: 1; min-width: 0; }
.basket-title { display: block; font-size: 32rpx; font-weight: 700; }
.basket-count { display: block; color: var(--muted); font-size: 24rpx; }
button.basket-header__action, .basket-header .icon-button {
  flex: 0 0 44px;
  width: 44px;
  min-height: 44px;
  padding: 0;
}
.basket-header .icon-button { margin-left: 8rpx; border-radius: 18rpx; background: var(--soft); }
.basket-pending { display: block; padding: 14rpx 18rpx; border-radius: 15rpx; background: var(--accent-light); color: var(--accent); font-size: 24rpx; }
.basket-list { max-height: 44vh; margin: 9rpx 0 18rpx; }
.basket-row { display: flex; align-items: center; height: 100rpx; border-bottom: 1rpx solid var(--line); }
.basket-row__image { flex: none; width: 74rpx; height: 74rpx; margin-right: 16rpx; border-radius: 15rpx; }
.basket-row__name { flex: 1; min-width: 0; margin-right: 12rpx; overflow: hidden; font-weight: 650; white-space: nowrap; text-overflow: ellipsis; }
.basket-row__remove { min-height: 66rpx; padding: 0 15rpx; color: var(--brand); }
button.basket-submit { display: flex; width: 100%; min-width: 100%; min-height: 44px; }

.wheel-sheet {
  max-height: 94vh;
  overflow-y: auto;
  padding: 32rpx 38rpx 34rpx;
  border-radius: 42rpx 42rpx 0 0;
  background: var(--paper);
  color: var(--ink);
}
.wheel-sheet__header { position: relative; padding: 6rpx 80rpx 0; text-align: center; }
.wheel-sheet__title { display: block; font-size: 52rpx; font-weight: 750; line-height: 1.18; }
.wheel-sheet__subtitle { display: block; min-height: 1.5em; margin-top: 12rpx; color: var(--ink); font-size: 27rpx; font-weight: 650; overflow-wrap: anywhere; }
button.wheel-sheet__close { position: absolute; top: -12rpx; right: -15rpx; width: 44px; height: 44px; }
.wheel-sheet__state { min-height: 210rpx; display: flex; align-items: center; justify-content: center; color: var(--muted); text-align: center; }
.wheel-sheet__notice { display: block; margin: 14rpx 0 0; color: var(--accent); font-size: 22rpx; text-align: center; }
.wheel-stage {
  position: relative;
  width: min(674rpx, 47vh);
  height: min(674rpx, 47vh);
  margin: 36rpx auto 34rpx;
}
.wheel-disc__canvas { display: block; width: 100%; height: 100%; }
.wheel-sheet__actions { display: flex; gap: 20rpx; margin-top: 22rpx; }
button.wheel-sheet__shuffle, button.wheel-sheet__retry, button.wheel-sheet__spin {
  display: flex;
  min-width: 0;
  min-height: max(88rpx, 44px);
  padding: 0 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
button.wheel-sheet__shuffle { flex: 2 1 0; border: 2rpx solid var(--brand); background: transparent; }
button.wheel-sheet__shuffle[disabled] { border-color: var(--line-strong); color: var(--muted); }
button.wheel-sheet__retry { flex: 2 1 0; }
button.wheel-sheet__retry[disabled] { color: var(--muted); }
button.wheel-sheet__spin { flex: 3 1 0; }
.wheel-sheet__note { display: block; margin-top: 18rpx; color: var(--muted); font-size: 24rpx; text-align: center; overflow-wrap: anywhere; }
.wheel-recommendation { display: flex; align-items: center; gap: 20rpx; margin: 28rpx 0 10rpx; padding: 22rpx; border: 1rpx solid var(--line); border-radius: var(--panel-radius); background: var(--surface); }
.wheel-recommendation__image { flex: none; width: 128rpx; height: 128rpx; border-radius: var(--field-radius); }
.wheel-recommendation__copy { min-width: 0; }
.wheel-recommendation__title { display: block; color: var(--muted); font-size: 24rpx; }
.wheel-recommendation__name { display: block; margin-top: 3rpx; font-size: 36rpx; font-weight: 700; overflow-wrap: anywhere; }
.wheel-candidates { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 28rpx 0; }
.wheel-candidates__dish { max-width: 100%; padding: 8rpx 14rpx; border-radius: 16rpx; background: var(--brand-light); overflow-wrap: anywhere; }

@media (max-height: 550px) {
  .menu-hero__image { width: 118rpx; height: 102rpx; }
  .toolbar { padding-top: 10rpx; padding-bottom: 10rpx; }
}
