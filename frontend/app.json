{
  "pages": [
    "pages/index/index",
    "pages/order/order",
    "pages/user/user"
  ],
  "subPackages": [
    {
      "root": "packages/catalog",
      "name": "catalog",
      "pages": [
        "recipe/detail",
        "recipe/editor",
        "category/manage"
      ]
    },
    {
      "root": "vegetable",
      "pages": [
        "index/create",
        "index/detail",
        "category/manage"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
