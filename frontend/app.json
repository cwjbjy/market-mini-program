{
  "pages": [
    "pages/index/index",
    "pages/order/order",
    "pages/user/user"
  ],
  "subPackages": [
    {
      "root": "vegetable",
      "pages": [
        "index/create",
        "index/detail",
        "category/manage"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": [
        "vegetable"
      ]
    }
  },
  "window": {
    "navigationBarTitleText": "爱情厨房",
    "navigationBarBackgroundColor": "#FAF6F1",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#FAF6F1"
  },
  "tabBar": {
    "color": "#775E50",
    "selectedColor": "#B74935",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tab/home.png",
        "selectedIconPath": "static/tab/home-active.png"
      },
      {
        "pagePath": "pages/order/order",
        "text": "订单",
        "iconPath": "static/tab/order.png",
        "selectedIconPath": "static/tab/order-active.png"
      },
      {
        "pagePath": "pages/user/user",
        "text": "账号",
        "iconPath": "static/tab/account.png",
        "selectedIconPath": "static/tab/account-active.png"
      }
    ]
  },
  "usingComponents": {
    "t-icon": "tdesign-miniprogram/icon/icon"
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
