page, .kitchen-tabs {
  --paper: #F7F7EF;
  --surface: #FFFFFF;
  --ink: #243120;
  --muted: #586452;
  --line: #DEE5D6;
  --line-strong: #BBC8B3;
  --brand: #3D5A3E;
  --brand-light: #E9F0E4;
  --soft: #EDF1E8;
  --field: #FBFCF7;
  --on-brand: #FFFFFF;
  --hero-light: #FCF6E7;
  --hero-shade: #E7EFDF;
  --dark: #293D2A;
  --on-dark: #FBFAF0;
  --on-dark-muted: #DCE6D5;
  --shadow: rgba(36, 49, 32, .18);
  --photo-shade: rgba(36, 49, 32, .35);
  --accent: #765018;
  --accent-light: #F8EDCF;
  --accent-fill: #F0D298;
  --on-accent: #382C16;
  --danger: #983F35;
  --danger-light: #F9ECE8;
  --disabled: #E3E9DE;
  --on-disabled: #576450;
  --tab-bar-height: 96rpx;
}

page {
  --gutter: 24rpx;
  --panel-radius: 24rpx;
  --field-radius: 16rpx;
  --field-gap: 24rpx;
  --td-brand-color: var(--brand);
  --td-brand-color-light: var(--brand-light);
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, button, input, textarea, image, scroll-view { box-sizing: border-box; }

button {
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: 1.4;
}
button::after { border: 0; }

.primary, .secondary, .quiet, .danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 84rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  font-weight: 600;
}
.primary { background: var(--brand); color: var(--on-brand); }
.primary[disabled] { background: var(--disabled); color: var(--on-disabled); }
.secondary { background: var(--brand-light); color: var(--brand); }
.quiet { color: var(--muted); }
.danger { background: var(--danger-light); color: var(--danger); }

.action-content {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: center;
  line-height: 1.25;
  white-space: nowrap;
}
.action-content > text { margin-left: 7rpx; }

.screen { padding: var(--gutter) var(--gutter) 36rpx; }
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 70rpx 32rpx;
  text-align: center;
}
.state__title { display: block; font-size: 35rpx; font-weight: 700; }
.state__description { display: block; max-width: 100%; color: var(--muted); font-size: 26rpx; line-height: 1.55; }
.state__symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  background: var(--brand-light);
  color: var(--brand);
}

.panel {
  border: 1rpx solid var(--line);
  border-radius: var(--panel-radius);
  background: var(--surface);
}
.form-label { display: block; margin-bottom: 12rpx; font-size: 28rpx; font-weight: 600; }
.field {
  display: block;
  width: 100%;
  height: 86rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--field-radius);
  background: var(--field);
  color: var(--ink);
  font-size: 28rpx;
}
.field--area { height: 174rpx; padding: 18rpx 22rpx; line-height: 1.6; }
.field--picker { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.field--placeholder { color: var(--muted); }
.form-error { display: block; color: var(--danger); font-size: 26rpx; line-height: 1.5; }

.image-placeholder {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--soft);
  color: var(--muted);
}
.image-placeholder > image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.sheet {
  padding: 18rpx 28rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: var(--surface);
  color: var(--ink);
}
