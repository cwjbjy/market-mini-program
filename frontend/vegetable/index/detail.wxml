<view wx:if="{{recipe}}" class="recipe-detail">
  <view class="recipe-hero image-placeholder" bindtap="showImage" role="button" aria-label="查看菜谱图片">
    <image wx:if="{{recipe.imageUrl}}" mode="aspectFill" src="{{recipe.imageUrl}}" />
    <t-icon wx:else name="image" size="82rpx" />
  </view>
  <view class="recipe-content">
    <view class="recipe-head panel">
      <text class="recipe-title">{{recipe.name}}</text>
      <text wx:if="{{recipe.orderCount}}" class="recipe-count">点单 {{recipe.orderCount}} 次</text>
    </view>
    <text wx:if="{{loadError}}" class="form-error">{{loadError}}</text>
    <view class="recipe-section panel">
      <view class="recipe-section__heading">
        <view class="recipe-section__icon"><t-icon name="view-list" size="34rpx" /></view>
        <text>食材配料</text>
      </view>
      <view class="recipe-ingredients" wx:if="{{ingredients.length}}">
        <text class="recipe-tag" wx:for="{{ingredients}}" wx:key="id">{{item.label}}</text>
      </view>
      <text wx:else class="recipe-text">暂无配料</text>
    </view>
    <view class="recipe-section panel">
      <view class="recipe-section__heading">
        <view class="recipe-section__icon"><t-icon name="edit" size="34rpx" /></view>
        <text>制作步骤</text>
      </view>
      <text class="recipe-text" selectable>{{recipe.steps || '暂无步骤'}}</text>
    </view>
  </view>
  <view class="recipe-footer">
    <button class="primary" bindtap="editRecipe"><t-icon name="edit" size="36rpx" />编辑菜谱</button>
  </view>
</view>
<view wx:else class="state">
  <text class="state__title">{{loading ? '正在加载菜谱' : '菜谱无法显示'}}</text>
  <text wx:if="{{loadError}}" class="state__description">{{loadError}}</text>
  <button wx:if="{{!loading}}" class="secondary" bindtap="loadRecipe">重试</button>
  <button wx:if="{{!loading}}" class="quiet" bindtap="goHome">返回首页</button>
</view>
