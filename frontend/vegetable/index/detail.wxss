.recipe-detail { padding-bottom: calc(124rpx + env(safe-area-inset-bottom)); }
.recipe-hero { height: 470rpx; }
.recipe-content { position: relative; display: flex; flex-direction: column; gap: 19rpx; margin-top: -42rpx; padding: 0 24rpx; }
.recipe-head { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; align-items: baseline; padding: 28rpx 25rpx; }
.recipe-title { color: var(--ink); font-size: 44rpx; font-weight: 700; word-break: break-all; }
.recipe-count { white-space: nowrap; font-size: 24rpx; color: var(--muted); }
.recipe-section { padding: 23rpx 25rpx; }
.recipe-section__heading { display: flex; align-items: center; gap: 14rpx; margin-bottom: 17rpx; font-weight: 700; font-size: 32rpx; }
.recipe-section__icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; background: var(--brand-light); color: var(--brand); border-radius: 17rpx; }
.recipe-ingredients { display: flex; gap: 12rpx; flex-wrap: wrap; }
.recipe-tag { padding: 10rpx 18rpx; border-radius: 16rpx; background: #F4ECE4; color: var(--ink); font-size: 26rpx; word-break: break-all; }
.recipe-text { color: var(--muted); line-height: 1.75; white-space: pre-wrap; word-break: break-all; }
.recipe-footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: #FFFDFB; border-top: 1rpx solid var(--line); }
