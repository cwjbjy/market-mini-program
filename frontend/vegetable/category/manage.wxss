.category-page { padding: 23rpx 24rpx 34rpx; }
.category-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }
.category-head__title { font-size: 38rpx; font-weight: 700; }
.category-create { min-height: 76rpx; padding: 0 22rpx; }
.category-list { display: flex; flex-direction: column; gap: 14rpx; }
.category-row { display: flex; align-items: center; gap: 14rpx; padding: 17rpx 14rpx 17rpx 17rpx; min-height: 116rpx; }
.category-row__image { flex: none; width: 83rpx; height: 83rpx; border-radius: 18rpx; }
.category-row__body { flex: 1; min-width: 0; }
.category-row__name, .category-row__count { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.category-row__name { font-weight: 700; font-size: 30rpx; }
.category-row__count { margin-top: 4rpx; font-size: 24rpx; color: var(--muted); }
.category-row__action { flex: none; width: 73rpx; min-height: 73rpx; padding: 0; color: var(--muted); border-radius: 17rpx; }
.category-row__action--delete { color: var(--brand); }
.category-empty { padding-top: 115rpx; }
.category-warning { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; padding: 0 10rpx 0 20rpx; color: var(--brand); }
.category-sheet { padding: 10rpx 26rpx calc(25rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #FFFDFB; }
.category-sheet__head { display: flex; justify-content: space-between; align-items: center; min-height: 85rpx; }
.category-sheet__title { font-size: 34rpx; font-weight: 700; }
.category-sheet__field { margin-bottom: 22rpx; }
.category-sheet__image-row { display: flex; gap: 18rpx; align-items: center; }
.category-sheet__image { flex: none; width: 118rpx; height: 118rpx; border-radius: 22rpx; }
.category-sheet__image-row .secondary { min-height: 76rpx; }
.category-sheet__submit { width: 100%; margin-top: 18rpx; }
