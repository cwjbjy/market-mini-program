<wxs src="./layout.wxs" module="layout" />

<view class="screen card-order-page">
  <view wx:if="{{items.length}}" class="sort-list">
    <view class="sort-header">
      <text class="sort-title">{{categoryName}}</text>
      <text wx:if="{{items.length > 1}}" class="sort-hint">{{orderSaving ? '正在保存顺序…' : '长按菜谱卡片即可拖动排序'}}</text>
    </view>
    <view wx:if="{{loadError}}" class="sort-warning panel">
      <text>{{loadError}}</text>
      <button class="quiet" bindtap="loadItems">重试</button>
    </view>
    <view wx:for="{{items}}" wx:key="id" class="sort-row card-order-row {{dragIndex === index ? 'sort-row--dragging' : ''}}"
      data-index="{{index}}" data-can-drag="{{items.length > 1 && !orderSaving}}"
      bindtouchstart="{{layout.touchStart}}" bindlongpress="{{layout.holdCard}}" bindtouchmove="{{layout.moveCard}}"
      bindtouchend="{{layout.touchEnd}}" bindtouchcancel="{{layout.touchCancel}}">
      <view class="sort-card panel"
        style="transform: translateY({{layout.offset(index, dragIndex, dragTarget, dragOffset, dragStride)}}px)">
        <view class="sort-image image-placeholder">
          <t-icon name="image" size="36rpx" aria-hidden="true" />
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        </view>
        <text class="sort-name">{{item.name}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="panel state">
    <view class="state__symbol">
      <t-icon name="{{loading ? 'loading' : 'view-list'}}" size="48rpx" aria-hidden="true" />
    </view>
    <text class="state__title">{{loading ? '正在加载菜谱' : loadError ? '菜谱加载失败' : '暂无菜谱'}}</text>
    <text wx:if="{{loadError}}" class="state__description">{{loadError}}</text>
    <button wx:if="{{loadError}}" class="secondary" bindtap="loadItems">重试</button>
  </view>
</view>
