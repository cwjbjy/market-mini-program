.editor { display: flex; flex-direction: column; padding: var(--gutter) var(--gutter) 50rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.editor-panel { padding: var(--gutter); }
.editor-photo {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: var(--field-gap);
  padding: var(--gutter);
}
.editor-photo__body { flex: 1; min-width: 0; }
.editor-photo__title { display: block; color: var(--ink); font-size: 30rpx; font-weight: 700; }
.editor-photo__hint { display: block; margin-top: 5rpx; color: var(--muted); font-size: 24rpx; }
.editor-fields { display: flex; flex-direction: column; }
.editor-fields > view + view { margin-top: var(--field-gap); }
button.photo {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 196rpx;
  height: 196rpx;
  margin: 0;
  padding: 0;
  border-radius: var(--field-radius);
}
button.photo--choose {
  border: 2rpx dashed var(--line-strong);
  background: var(--field);
  color: var(--muted);
}
button.photo-replace {
  display: inline-flex;
  width: auto;
  min-height: 44px;
  margin: 12rpx 0 0;
  padding: 0 18rpx;
  border-radius: var(--field-radius);
  font-size: 25rpx;
  white-space: nowrap;
}
button.photo-replace--pressed { background: var(--soft); }
button.photo-replace[disabled] { opacity: .55; }
.field--picker text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.field--area { height: 130rpx; }
.editor-submit { margin-top: 30rpx; }
.editor-submit .primary { display: flex; width: 100%; min-height: 90rpx; }
.editor-submit .form-error { margin-bottom: 12rpx; }
.ingredient-heading, .ingredient-preview__heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.ingredient-heading .form-label { margin-bottom: 0; }
button.ingredient-paste-button { display: flex; min-height: 44px; padding: 0 18rpx; font-size: 25rpx; }
.ingredient-hint { display: block; margin: 8rpx 0 12rpx; color: var(--muted); font-size: 25rpx; }
.ingredient-row + .ingredient-row { margin-top: 12rpx; }
.ingredient-row__input { display: flex; align-items: center; gap: 8rpx; }
.ingredient-row__input .field { flex: 1; min-width: 0; min-height: 44px; }
.ingredient-field--invalid { border-color: var(--accent-fill); background: var(--hero-light); }
button.ingredient-remove { flex: none; width: 44px; height: 44px; color: var(--muted); }
.ingredient-feedback { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 4rpx; color: var(--accent); font-size: 23rpx; }
.ingredient-feedback text { flex: 1; }
button.ingredient-note { flex: none; min-height: 44px; padding: 0 14rpx; background: var(--accent-light); color: var(--accent); font-size: 23rpx; }
button.ingredient-add { display: flex; width: 100%; min-height: 44px; margin-top: 14rpx; border: 2rpx dashed var(--line-strong); background: transparent; }
.ingredient-preview { margin-top: 18rpx; padding: 17rpx 20rpx; border-radius: var(--field-radius); background: linear-gradient(120deg, var(--hero-light), var(--hero-shade)); }
.ingredient-preview__heading { font-weight: 650; }
.ingredient-counter { flex: none; color: var(--muted); font-size: 23rpx; font-weight: 400; }
.ingredient-counter--over { color: var(--danger); }
.ingredient-preview__items { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.ingredient-chip { max-width: 100%; padding: 4rpx 14rpx; border: 1rpx solid var(--line); border-radius: 30rpx; background: var(--surface); font-size: 24rpx; overflow-wrap: anywhere; }
.ingredient-preview .ingredient-hint { margin-bottom: 0; }
.ingredient-hint--pending { color: var(--accent); }
.ingredient-paste { width: 640rpx; max-width: calc(100vw - 32px); padding: 24rpx; background: var(--paper); }
.ingredient-paste__field { height: 215rpx; }
.ingredient-paste__actions { display: flex; gap: 14rpx; margin-top: 20rpx; }
.ingredient-paste__actions button { flex: 1; min-height: 44px; }
.instruction-draft, .instruction-tip { margin-bottom: 12rpx; }
.instruction-draft { padding: 0 14rpx 14rpx; border: 1rpx solid var(--line); border-radius: var(--field-radius); }
.instruction-draft__head, .instruction-tip { display: flex; align-items: center; gap: 4rpx; }
.instruction-draft__number { flex: 1; color: var(--brand); font-size: 25rpx; font-weight: 650; }
.instruction-draft .icon-button, .instruction-tip .icon-button { flex: none; width: 44px; height: 44px; color: var(--muted); }
.instruction-draft .icon-button[disabled] { opacity: .35; }
.instruction-input { height: auto; min-height: 92rpx; }
.instruction-tip .instruction-input { flex: 1; min-width: 0; }
